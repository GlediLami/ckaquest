#!/usr/bin/env bash
# CKAQuest cluster manager.
#
#   cq-cluster up                create the 3-node cluster and base add-ons
#   cq-cluster down              delete the cluster
#   cq-cluster rebuild           down + up (last resort when a level broke the cluster)
#   cq-cluster status            show nodes and add-ons
#   cq-cluster addon <name>      install an on-demand add-on: ingress | gateway
#   cq-cluster lab-up [--no-cni] create the small lab cluster (upgrade / CNI practice)
#   cq-cluster lab-down          delete the lab cluster
#   cq-cluster bare-up           start 2 bare nodes (no cluster yet) for kubeadm init/join practice
#   cq-cluster bare-down         remove the bare nodes
#
# Only touches the CKAQuest kubeconfig (~/.ckaquest/kubeconfig by default).
set -euo pipefail
source "$(dirname "$0")/../lib/common.sh"
source "$CQ_ROOT/cluster/versions.env"

log() { printf '\033[36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cluster_exists() { "$CQ_KIND" get clusters 2>/dev/null | grep -qx "$1"; }

check_prereqs() {
  command -v docker >/dev/null || die "docker not found"
  docker info >/dev/null 2>&1 || die "docker is not running"
  command -v kubectl >/dev/null || die "kubectl not found"
  command -v "$CQ_KIND" >/dev/null || die "kind not found"
  local have
  have="$("$CQ_KIND" version | awk '{print $2}' | tr -d v)"
  if [ "$(printf '%s\n%s\n' "$MIN_KIND_VERSION" "$have" | sort -V | head -1)" != "$MIN_KIND_VERSION" ]; then
    die "kind $have is too old for the v1.37 node image. Need >= $MIN_KIND_VERSION (brew upgrade kind, or see README)."
  fi
}

install_metrics_server() {
  log "metrics-server $METRICS_SERVER_VERSION"
  kubectl apply -f "https://github.com/kubernetes-sigs/metrics-server/releases/download/${METRICS_SERVER_VERSION}/components.yaml" >/dev/null
  # kind kubelets use self-signed serving certs
  if ! kubectl -n kube-system get deploy metrics-server -o jsonpath='{.spec.template.spec.containers[0].args}' | grep -q kubelet-insecure-tls; then
    kubectl -n kube-system patch deploy metrics-server --type=json \
      -p '[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]' >/dev/null
  fi
}

install_crds() {
  log "Gateway API CRDs $GATEWAY_API_VERSION"
  kubectl apply --server-side -f "https://github.com/kubernetes-sigs/gateway-api/releases/download/${GATEWAY_API_VERSION}/standard-install.yaml" >/dev/null
  log "VPA CRDs ($VPA_VERSION)"
  kubectl apply -f "https://raw.githubusercontent.com/kubernetes/autoscaler/${VPA_VERSION}/vertical-pod-autoscaler/deploy/vpa-v1-crd-gen.yaml" >/dev/null
}

addon_ingress() {
  if kubectl -n ingress-nginx get deploy ingress-nginx-controller >/dev/null 2>&1; then return 0; fi
  log "ingress-nginx $INGRESS_NGINX_VERSION"
  kubectl apply -f "https://raw.githubusercontent.com/kubernetes/ingress-nginx/${INGRESS_NGINX_VERSION}/deploy/static/provider/kind/deploy.yaml" >/dev/null
  kubectl -n ingress-nginx rollout status deploy/ingress-nginx-controller --timeout=180s >/dev/null
}

addon_gateway() {
  if kubectl get gatewayclass nginx >/dev/null 2>&1; then return 0; fi
  command -v helm >/dev/null || die "helm not found (needed for the Gateway controller)"
  log "NGINX Gateway Fabric $NGF_VERSION (gatewayClassName: nginx)"
  helm upgrade --install ngf oci://ghcr.io/nginx/charts/nginx-gateway-fabric \
    --version "$NGF_VERSION" -n nginx-gateway --create-namespace \
    --set nginx.service.type=NodePort --wait --timeout 5m >/dev/null
}

bootstrap_nodes() {
  local cluster="$1" node role
  log "node tools (vim, completion, etcdctl) on $cluster nodes"
  for node in $("$CQ_KIND" get nodes --name "$cluster"); do
    role=worker
    [[ "$node" == *control-plane ]] && role=controlplane
    docker cp "$CQ_ROOT/cluster/node-bootstrap.sh" "$node:/root/.cq-node-bootstrap.sh" >/dev/null
    docker exec "$node" bash /root/.cq-node-bootstrap.sh "$role" &
  done
  wait
}

cmd_up() {
  check_prereqs
  mkdir -p "$CQ_HOME" "$CQ_WORK"
  if cluster_exists "$CQ_CLUSTER"; then
    log "cluster $CQ_CLUSTER exists, refreshing kubeconfig"
    "$CQ_KIND" export kubeconfig --name "$CQ_CLUSTER" --kubeconfig "$KUBECONFIG" >/dev/null
  else
    log "creating cluster $CQ_CLUSTER (1 control plane + 2 workers, v1.37)"
    "$CQ_KIND" create cluster --name "$CQ_CLUSTER" --config "$CQ_ROOT/cluster/kind-config.yaml" \
      --kubeconfig "$KUBECONFIG" --wait 180s
  fi
  chmod 600 "$KUBECONFIG"
  kubectl config use-context "$CQ_CONTEXT" >/dev/null
  install_metrics_server
  install_crds
  bootstrap_nodes "$CQ_CLUSTER"
  cq_ensure_namespace ckaquest
  kubectl config set-context --current --namespace=default >/dev/null
  log "ready. In your kubectl terminal run:  source $CQ_ROOT/env.sh"
}

cmd_down() {
  if cluster_exists "$CQ_CLUSTER"; then
    "$CQ_KIND" delete cluster --name "$CQ_CLUSTER" --kubeconfig "$KUBECONFIG"
  else
    log "cluster $CQ_CLUSTER does not exist"
  fi
}

cmd_status() {
  kubectl config current-context
  kubectl get nodes -o wide
  echo
  kubectl get deploy -A -l 'k8s-app=metrics-server' 2>/dev/null || true
  kubectl get gatewayclass 2>/dev/null || true
  kubectl -n ingress-nginx get deploy 2>/dev/null || true
  cluster_exists "$CQ_LAB_CLUSTER" && echo "lab cluster: $CQ_LAB_CLUSTER (context $CQ_LAB_CONTEXT)" || true
}

cmd_lab_up() {
  check_prereqs
  local no_cni=false
  [ "${1:-}" = "--no-cni" ] && no_cni=true
  if cluster_exists "$CQ_LAB_CLUSTER"; then
    log "lab cluster exists"
    "$CQ_KIND" export kubeconfig --name "$CQ_LAB_CLUSTER" --kubeconfig "$KUBECONFIG" >/dev/null
    return 0
  fi
  local cfg="$CQ_HOME/lab-config.yaml"
  cat > "$cfg" <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: $no_cni
  podSubnet: "10.244.0.0/16"
nodes:
  - role: control-plane
    image: $LAB_NODE_IMAGE
  - role: worker
    image: $LAB_NODE_IMAGE
EOF
  log "creating lab cluster $CQ_LAB_CLUSTER (no CNI: $no_cni)"
  # --wait does not work without a CNI, the nodes stay NotReady on purpose
  if $no_cni; then
    "$CQ_KIND" create cluster --name "$CQ_LAB_CLUSTER" --config "$cfg" --kubeconfig "$KUBECONFIG"
  else
    "$CQ_KIND" create cluster --name "$CQ_LAB_CLUSTER" --config "$cfg" --kubeconfig "$KUBECONFIG" --wait 180s
  fi
  bootstrap_nodes "$CQ_LAB_CLUSTER"
  # kind switches the current context to the new cluster. Switch back.
  kubectl config use-context "$CQ_CONTEXT" >/dev/null
}

# Bare nodes: kindest/node containers started without kind. systemd and containerd run,
# kubelet waits for "kubeadm init" or "kubeadm join".
BARE_NODES="ckaquest-bare-cp ckaquest-bare-worker"

cmd_bare_up() {
  check_prereqs
  local node
  for node in $BARE_NODES; do
    if docker inspect "$node" >/dev/null 2>&1; then
      log "$node exists"
      continue
    fi
    log "starting bare node $node"
    docker run -d --name "$node" --hostname "$node" --network kind \
      --privileged --security-opt seccomp=unconfined --security-opt apparmor=unconfined \
      --tmpfs /tmp --tmpfs /run -v /var -v /lib/modules:/lib/modules:ro \
      --cgroupns=private -e container=docker --label io.ckaquest.bare=true \
      "$LAB_NODE_IMAGE" >/dev/null
  done
  sleep 10
  for node in $BARE_NODES; do
    # A container cannot swapoff and WSL has swap, so kubelet must accept it.
    docker exec "$node" bash -c 'echo "KUBELET_EXTRA_ARGS=--fail-swap-on=false" > /etc/default/kubelet'
    docker cp "$CQ_ROOT/cluster/node-bootstrap.sh" "$node:/root/.cq-node-bootstrap.sh" >/dev/null
    docker exec "$node" bash /root/.cq-node-bootstrap.sh worker &
  done
  wait
  install_proxy_fix ckaquest-bare-cp
  log "bare nodes ready: $BARE_NODES"
}

install_proxy_fix() {
  local node="$1"
  docker cp "$CQ_ROOT/cluster/bare-proxy-fix.sh" "$node:/usr/local/sbin/cq-proxy-fix" >/dev/null
  docker exec "$node" bash -c 'chmod +x /usr/local/sbin/cq-proxy-fix
cat > /etc/systemd/system/cq-proxy-fix.service <<UNIT
[Unit]
Description=CKAQuest: kube-proxy conntrack setting for container nodes
[Service]
ExecStart=/usr/local/sbin/cq-proxy-fix
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload && systemctl enable --now cq-proxy-fix >/dev/null 2>&1'
}

cmd_bare_down() {
  local node
  for node in $BARE_NODES; do
    docker inspect "$node" >/dev/null 2>&1 && docker rm -f -v "$node" >/dev/null && log "removed $node"
  done
  return 0
}

cmd_lab_down() {
  if cluster_exists "$CQ_LAB_CLUSTER"; then
    "$CQ_KIND" delete cluster --name "$CQ_LAB_CLUSTER" --kubeconfig "$KUBECONFIG"
  fi
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  rebuild) cmd_down; cmd_up ;;
  status) cmd_status ;;
  addon)
    case "${2:-}" in
      ingress) addon_ingress ;;
      gateway) addon_gateway ;;
      *) die "unknown add-on '${2:-}' (ingress | gateway)" ;;
    esac ;;
  lab-up) shift; cmd_lab_up "$@" ;;
  lab-down) cmd_lab_down ;;
  bare-up) cmd_bare_up ;;
  bare-down) cmd_bare_down ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
